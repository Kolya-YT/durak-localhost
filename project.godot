; Engine configuration file.
; Durak LAN - Android local multiplayer card game.

config_version=5

[application]

config/name="Дурак LAN"
config/description="Локальная карточная игра Дурак для Android по Wi-Fi и точке доступа."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/version="0.1.0"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=720
window/size/window_height_override=1280
window/handheld/orientation=1
window/stretch/mode="canvas_items"

[rendering]

textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[gui]

theme/default_font_multichannel_signed_distance_field=true

[network]

limits/debugger/max_chars_per_second=4096

